# Copiá este archivo como .env y completá los valores de tu proyecto.
# El .env real no se sube a GitHub (está en .gitignore). En Vercel van en Settings → Environment Variables.

# Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web)
# Llevan VITE_ porque las usa el navegador: la configuración web de Firebase es pública
# y los datos se protegen con las reglas de firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Claves privadas: SIN prefijo VITE_, así Vite no las incluye en el código del navegador.
# Solo las usan las funciones del servidor de la carpeta /api (en Vercel, tipo Secret).
# OMDb – datos de IMDb (clave gratuita en https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=
# TMDB – estrenos, tendencias y plataformas (clave gratuita en https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
